<Window x:Class="FlaUI.Cli.TestApp.DpiTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlaUI DPI acceptance" Width="600" Height="420" Background="White"
        PreviewMouseDown="OnMouseDown">
    <Grid Margin="12">
        <TextBlock Text=" " Width="24" Height="24" Background="Red" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.AutomationId="DpiTopLeft" />
        <TextBlock Text=" " Width="24" Height="24" Background="Lime" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.AutomationId="DpiTopRight" />
        <TextBlock Text=" " Width="24" Height="24" Background="Blue" HorizontalAlignment="Left" VerticalAlignment="Bottom" AutomationProperties.AutomationId="DpiBottomLeft" />
        <TextBlock Text=" " Width="24" Height="24" Background="Yellow" HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.AutomationId="DpiBottomRight" />
        <StackPanel Margin="40">
            <TextBlock x:Name="MouseStatus" Text="mouse=0" AutomationProperties.AutomationId="DpiMouseStatus" />
            <TextBlock x:Name="SelectionStatus" Text="selected=none" AutomationProperties.AutomationId="DpiSelectionStatus" />
            <DataGrid x:Name="Rows" AutoGenerateColumns="False" Height="180" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OnSelectionChanged"
                      EnableRowVirtualization="True" AutomationProperties.AutomationId="DpiGrid">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Batch" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}" Padding="8" AutomationProperties.AutomationId="{Binding Key}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <CheckBox Content="Pattern action" AutomationProperties.AutomationId="DpiToggle" />
        </StackPanel>
    </Grid>
</Window>
